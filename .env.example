# Copiá a .env.local y completá con valores reales (no subas secretos a git).

NEXTAUTH_SECRET="generar-con: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Misma URL para la app y para `prisma migrate deploy` / `db:migrate:dev`
# En Vercel + Postgres, usá URL con pooler (Neon/Supabase) y límites bajos; ej. ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambiar

OPENAI_API_KEY=

META_APP_ID=
META_APP_SECRET=
# Challenge GET webhook Meta (Messenger/IG); si vacío, algunos flujos usan WHATSAPP_VERIFY_TOKEN
META_WEBHOOK_VERIFY_TOKEN=
# Debe coincidir con el verify token del webhook de WhatsApp Cloud API (GET hub.verify_token)
WHATSAPP_VERIFY_TOKEN=

# Vercel Blob (mensajería interna: imágenes, audio, video, documentos). Opcional en local.
# BLOB_READ_WRITE_TOKEN=
