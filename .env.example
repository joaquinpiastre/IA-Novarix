# Base de datos
DATABASE_URL="postgresql://user:pass@localhost:5432/novarix"

# Auth
NEXTAUTH_SECRET="generá-un-secreto-largo"
NEXTAUTH_URL="http://localhost:3000"

# OpenAI
OPENAI_API_KEY="sk-..."

# WhatsApp Meta API
WHATSAPP_APP_SECRET=""
WHATSAPP_API_VERSION="v18.0"
WHATSAPP_VERIFY_TOKEN="token-para-verificar-webhook"

# Misma app Meta: Facebook Messenger + Instagram (OAuth por empresa en /configuracion)
META_APP_ID=""
META_APP_SECRET=""
# Si META_APP_SECRET vacío, se usa WHATSAPP_APP_SECRET
# Opcional; si vacío se usa WHATSAPP_VERIFY_TOKEN para GET del webhook /api/webhook/meta
META_WEBHOOK_VERIFY_TOKEN=""
# redirect_uri OAuth = NEXT_PUBLIC_APP_URL + /api/meta/oauth/callback (prioridad sobre NEXTAUTH_URL), salvo:
# META_OAUTH_REDIRECT_URI="https://tu-dominio.com/api/meta/oauth/callback"

# Supabase (storage de archivos — opcional)
SUPABASE_URL="https://....supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_KEY=""

# Novarix Admin (seed)
ADMIN_EMAIL="contacto@novarix.agency"
ADMIN_PASSWORD="CambiarAdmin123!"

# App
NEXT_PUBLIC_APP_NAME="Novarix AI Platform"
NEXT_PUBLIC_APP_URL="https://app.novarix.agency"

# Cron seguimientos (opcional: GET /api/cron/seguimientos con Authorization: Bearer …)
CRON_SECRET=""
# Desactivar node-cron en el proceso Next (ej. serverless): 1 = off
# DISABLE_CRM_CRON="1"
