{
  "name": "novarix-ai-platform",
  "version": "0.1.4",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "dotenv -e .env.local -- prisma generate && node scripts/verify-no-old-web-import.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node scripts/verify-no-old-web-import.mjs && vitest run",
    "test:watch": "vitest",
    "postinstall": "dotenv -e .env.local -- prisma generate",
    "prisma": "dotenv -e .env.local -- prisma",
    "db:migrate:dev": "dotenv -e .env.local -- prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "dotenv -e .env.local -- prisma migrate deploy && tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.103.0",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "lucide-react": "^1.8.0",
    "next": "14.2.35",
    "next-auth": "^4.24.13",
    "node-cron": "^4.2.1",
    "openai": "^6.34.0",
    "pino": "^10.3.1",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "dotenv": "^17.4.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
