generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Multi-tenant: toda lectura/escritura de datos de cliente debe ir filtrada por `empresaId` del contexto
// autenticado (ver `requireEmpresaContext` en lib/api-auth.ts). No mezclar tenants en una sola query.
// Evolución de BD: solo `prisma migrate dev` / `migrate deploy` con SQL versionado en prisma/migrations;
// no usar `db push` contra bases con datos reales (riesgo de drift y pérdida). Ver docs/DATABASE.md.

// Tabla "empresas": el flag de cuenta habilitada es el campo "activo" (no existe columna "existe").
model Empresa {
  id                 String   @id @default(cuid())
  nombre             String
  email              String   @unique
  passwordHash       String
  rol                Rol      @default(CLIENTE)
  plan               Plan     @default(BASIC)
  creditosIncluidos  Int      @default(50)
  creditosUsados     Float    @default(0)
  activo             Boolean  @default(true)
  whatsappNumero     String?
  whatsappToken      String?
  whatsappPhoneId    String?
  whatsappVerifyToken String?
  // Facebook Page + Instagram (OAuth por empresa; token de la página de Meta)
  metaPageId            String?
  metaPageToken         String?
  metaPageNombre        String?
  metaInstagramId       String? // id de la cuenta profesional de Instagram (Graph API)
  metaInstagramUsername String?
  metaConectadoEn       DateTime?
  stockApiUrl         String? // GET JSON catálogo ERP (lib/stock-api.ts)
  stockApiToken       String?
  stockApiKeyHeader   String? // ej. X-API-Key; vacío + token = Bearer
  cotizacionIncluyeGrupos Boolean @default(true) // al armar cotizaciones, incluir chats de grupo WhatsApp
  chatIaPausado      Boolean  @default(false) // true: sin OpenAI ni respuestas auto (WhatsApp / Meta)
  creadoEn           DateTime @default(now())

  agentes          Agente[]
  conversaciones   Conversacion[]
  archivos         ArchivoConocimiento[]
  contactos        Contacto[]
  etapasCRM        EtapaCRM[]
  reglasFollowUp   ReglaFollowUp[]
  usuarios         Usuario[]
  canalesInternos  CanalInterno[]
  mensajesInternos MensajeInterno[]

  @@map("empresas")
}

/// Usuario interno del equipo (misma empresa). Se crea/actualiza al usar la mensajería con la sesión actual.
model Usuario {
  id               String   @id @default(cuid())
  empresaId        String
  empresa          Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre           String
  email            String
  activo           Boolean  @default(true)
  ultimaActividad  DateTime?
  creadoEn         DateTime @default(now())

  mensajesInternos MensajeInterno[]
  typingEn         MensajeriaTyping[]

  @@unique([empresaId, email])
  @@index([empresaId])
  @@map("usuarios_internos")
}

model CanalInterno {
  id          String   @id @default(cuid())
  empresaId   String
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre      String
  descripcion String?
  icono       String?  @default("💬")
  tipo        String   @default("general") // general, privado, anuncios
  creadoEn    DateTime @default(now())
  miembros    String[] // userIds de Usuario; vacío = todos los de la empresa

  mensajes MensajeInterno[]
  typing   MensajeriaTyping[]

  @@index([empresaId])
  @@map("canales_internos")
}

model MensajeInterno {
  id              String   @id @default(cuid())
  canalId         String
  canal           CanalInterno @relation(fields: [canalId], references: [id], onDelete: Cascade)
  empresaId       String
  empresa         Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuarioId       String
  usuario         Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  contenido       String?  @db.Text
  tipo            String   @default("texto") // texto, imagen, audio, video, archivo
  archivoUrl      String?
  archivoNombre   String?
  archivoTamano   Int? // bytes
  leido           Boolean  @default(false)
  leidoPor        String[] // ids de Usuario que leyeron
  creadoEn        DateTime @default(now())
  editadoEn       DateTime?
  eliminado       Boolean  @default(false)
  replyAId        String?
  replyA          MensajeInterno?  @relation("Reply", fields: [replyAId], references: [id], onDelete: SetNull)
  replies         MensajeInterno[] @relation("Reply")

  @@index([canalId, creadoEn])
  @@index([empresaId])
  @@map("mensajes_internos")
}

/// Indicador "escribiendo…" por canal (filas antiguas se ignoran si >5s).
model MensajeriaTyping {
  canalId       String
  usuarioId     String
  empresaId     String
  actualizadoEn DateTime @default(now())

  canal CanalInterno @relation(fields: [canalId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([canalId, usuarioId])
  @@index([empresaId])
  @@map("mensajeria_typing")
}

model Agente {
  id               String   @id @default(cuid())
  empresaId        String
  nombre           String
  slug             String? // identificador corto opcional (ej. martin-pintureria)
  descripcion      String?
  prompt           String   @db.Text
  promptTenant     String?  @db.Text // instrucciones extra del tenant (se anexan al system)
  activo           Boolean  @default(true)
  esDefault        Boolean  @default(false)
  codigoActivacion String?  @unique // palabra clave de ruteo (WhatsApp / canales)
  permiteTransferencia Boolean @default(false)
  responsableHumano   String? // nombre/rol de la persona humana que toma casos de este agente
  busquedaProductos    Boolean @default(true) // si false, no consulta API stock ERP
  temperatura      Float    @default(0.6)
  modeloOpenai     String   @default("gpt-4o-mini")
  maxTokens        Int      @default(1024)
  creadoEn         DateTime @default(now())

  empresa        Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  archivos       ArchivoConocimiento[]
  conversaciones Conversacion[]

  @@index([empresaId])
  @@map("agentes")
}

model ArchivoConocimiento {
  id        String      @id @default(cuid())
  empresaId String
  agenteId  String?
  nombre    String
  tipo      TipoArchivo
  url       String
  contenido String?     @db.Text
  creadoEn  DateTime    @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  agente  Agente? @relation(fields: [agenteId], references: [id], onDelete: SetNull)

  @@index([empresaId])
  @@map("archivos_conocimiento")
}

model Conversacion {
  id             String               @id @default(cuid())
  empresaId      String
  agenteId       String?
  numeroCliente  String // teléfono o id de grupo (@g.us)
  nombreCliente  String?
  etiquetaResponsable String? // etiqueta opcional para asignar el chat a una persona del equipo
  estado         EstadoConversacion   @default(ACTIVA)
  esGrupo        Boolean              @default(false) // WhatsApp grupo (from suele terminar en @g.us)
  iaHabilitada   Boolean              @default(true) // si false, no se llama a la IA en este chat
  atencionHumana AtencionHumanaEstado @default(NINGUNA) // cola humana: ACTIVA = pendiente, RESUELTA = cerrada por staff
  mensajes       Json                 @default("[]")
  tokensUsados   Int                  @default(0)
  creditosUsados Float                @default(0)
  iniciadoEn     DateTime             @default(now())
  ultimoMensaje  DateTime             @default(now())
  contactoId     String?
  canal          CanalConversacion    @default(WHATSAPP)

  empresa  Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  agente   Agente?   @relation(fields: [agenteId], references: [id], onDelete: SetNull)
  contacto Contacto? @relation(fields: [contactoId], references: [id], onDelete: SetNull)

  @@index([empresaId])
  @@map("conversaciones")
}

model Contacto {
  id                 String         @id @default(cuid())
  empresaId          String
  numero             String
  nombre             String?
  email              String?
  empresaCliente     String?
  etapaId            String?
  valorOportunidad   Float?
  notas              String?        @db.Text
  proximoSeguimiento DateTime?
  ultimaInteraccion  DateTime       @default(now())
  origen             OrigenContacto @default(WHATSAPP)
  creadoEn           DateTime       @default(now())

  empresa         Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  etapa           EtapaCRM?            @relation(fields: [etapaId], references: [id], onDelete: SetNull)
  conversaciones  Conversacion[]
  seguimientos    SeguimientoEnviado[]
  historialEtapas HistorialEtapa[]

  @@unique([empresaId, numero])
  @@map("contactos")
}

model EtapaCRM {
  id        String   @id @default(cuid())
  empresaId String
  nombre    String
  color     String   @default("#7B2FF7")
  orden     Int
  esGanado  Boolean  @default(false)
  esPerdido Boolean  @default(false)
  creadoEn  DateTime @default(now())

  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  contactos Contacto[]

  @@index([empresaId])
  @@map("etapas_crm")
}

model HistorialEtapa {
  id            String   @id @default(cuid())
  contactoId    String
  etapaAnterior String?
  etapaNueva    String
  cambiadoEn    DateTime @default(now())

  contacto Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  @@map("historial_etapas")
}

model ReglaFollowUp {
  id                String         @id @default(cuid())
  empresaId         String
  nombre            String
  activa            Boolean        @default(true)
  disparador        TipoDisparador
  diasEnEtapa       Int?
  horasSinRespuesta Int?
  etapaDisparoId    String?
  /// JSON string[]: si hay elementos, solo esos teléfonos/claves (m:, ig:). Vacío/null = regla general.
  numerosIncluidos  Json?
  /// Si true, no envía a contactos en etapa ganada o perdida del embudo.
  omitirGanadosPerdidos Boolean    @default(true)
  usarIA            Boolean        @default(true)
  promptMensaje     String?        @db.Text
  mensajeFijo       String?        @db.Text
  moverAEtapaId     String?
  creadoEn          DateTime       @default(now())

  empresa      Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  seguimientos SeguimientoEnviado[]

  @@index([empresaId])
  @@map("reglas_followup")
}

model SeguimientoEnviado {
  id         String               @id @default(cuid())
  reglaId    String
  contactoId String
  mensaje    String               @db.Text
  estado     EstadoEnvio          @default(PENDIENTE)
  enviadoEn  DateTime?
  creadoEn   DateTime             @default(now())
  canal      CanalConversacion?

  regla    ReglaFollowUp @relation(fields: [reglaId], references: [id], onDelete: Cascade)
  contacto Contacto      @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  @@map("seguimientos_enviados")
}

enum Rol {
  SUPERADMIN
  CLIENTE
}

enum Plan {
  BASIC
  PRO
  ENTERPRISE
}

enum TipoArchivo {
  EXCEL
  PDF
  CSV
  TEXTO
  WEB // catálogo importado desde una URL (HTML)
}

enum EstadoConversacion {
  ACTIVA
  RESUELTA
  DERIVADA_HUMANO
}

enum AtencionHumanaEstado {
  NINGUNA // sin pedido de humano explícito en cola
  ACTIVA  // necesita atención humana (pendiente)
  RESUELTA // el equipo cerró el caso; la IA puede volver a responder en mensajes nuevos
}

enum OrigenContacto {
  WHATSAPP
  MANUAL
  IMPORTADO
  FACEBOOK
  INSTAGRAM
}

enum CanalConversacion {
  WHATSAPP
  MESSENGER
  INSTAGRAM
}

enum TipoDisparador {
  TIEMPO_EN_ETAPA
  SIN_RESPUESTA
  ETAPA_ESPECIFICA
  FECHA_PROGRAMADA
}

enum EstadoEnvio {
  PENDIENTE
  ENVIADO
  ERROR
}
